/**
 * River Agent — WhatsApp sales (Path Direct Messaging API + River MCP).
 * Official mcp.360dialog.com = Hub admin only. Chat send = D360_API_KEY.
 */
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "river-agent-doorbell",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "DRY_RUN": "false",
    "REPLY_MODE": "worker",
    "D360_API_BASE": "https://waba-v2.360dialog.io",
    "RATE_LIMIT_MAX": "12",
    "RATE_LIMIT_WINDOW_SECONDS": "60",
    "DEDUPE_TTL_SECONDS": "86400",
    "SESSION_TTL_SECONDS": "604800",
    "BRAND_NAME": "EcoLife Automation / Charm Systems",
    "PUBLIC_SITE": "https://charmsystemsllc.com/",
    "SALES_CONTACT_EMAIL": "ceo@charmsystemsllc.com",
    "SALES_CONTACT_PHONE": "+27726064522",
    "HOT_LEAD_WA": "27727710400"
  },
  "kv_namespaces": [
    {
      "binding": "RIVER_KV",
      "id": "68a570e7d5474f3eb804f904c8f1c208",
      "preview_id": "00000000000000000000000000000000"
    }
  ]
}
